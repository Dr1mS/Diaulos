#!/usr/bin/env python3
"""Stand-in for `vibe-acp` (Mistral Vibe 2.20), for the tests. Python 3.8+,
standard library only.

It speaks the subset of the Agent Client Protocol that Diaulos uses, as
newline-delimited JSON-RPC on stdin/stdout, with the shapes recorded from the
real vibe-acp (prototypes/vibe-acp/out/run/*.jsonl):

  initialize, session/new, session/load, session/set_config_option,
  session/prompt (with session/update notifications), and, on demand, one
  session/request_permission sent to the client during a prompt.

Sessions are written like vibe writes them, under the save_dir of
$VIBE_HOME/config.toml ([session_logging] save_dir) or $VIBE_HOME/logs/session:
session_<YYYYMMDD_HHMMSS>_<first 8 hex>/{meta.json,messages.jsonl}.
session/load keeps the session id and the folder, and counts the stats of
this process only, as the real one does (probe vibe-acp A1, A4).

Each prompt that holds a <bridge-message ... from="X"> block makes the fake
answer X with "pong from vibe:<suffix>" through `bridge.py send X ... --from
vibe:<suffix>` when $BRIDGE is set, like tests/fakes/agy.

Environment:
  VIBE_HOME        required: the throwaway vibe home.
  FAKE_VIBE_LOG    JSON lines: process start, every message received, every
                   permission answer, exit.
  FAKE_VIBE_MODE   comma-separated behaviours:
                     permission      send one session/request_permission per
                                     prompt and log the option chosen
                     die-in-prompt   exit 3 during the prompt, before saving
                     die-after-save  exit 3 during the prompt, after the user
                                     message is saved (a replay is a duplicate)
                     error-prompt    answer session/prompt with an internal error
                     turn-limit      end the prompt as vibe's TurnLimitMiddleware
                                     would, without a reply to the sender
                     slow=<seconds>  wait that long inside each prompt
  FAKE_VIBE_COST   cost added per prompt, in USD (default 0.01).
  BRIDGE           path of bridge.py, for the reply.

Options: -v and --setup are accepted, as by the real one; anything else exits 2.
"""
import json
import os
import re
import secrets
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone

INVALID_PARAMS = -32602
METHOD_NOT_FOUND = -32601
INTERNAL_ERROR = -32603

MODES = [m.strip() for m in os.environ.get("FAKE_VIBE_MODE", "").split(",") if m.strip()]
COST = float(os.environ.get("FAKE_VIBE_COST", "0.01"))
VIBE_HOME = os.environ["VIBE_HOME"]
LOG = os.environ.get("FAKE_VIBE_LOG")


def mode_value(name):
    for m in MODES:
        if m.startswith(name + "="):
            return m.split("=", 1)[1]
    return None


def log(record):
    if not LOG:
        return
    record = dict(record, t=round(time.time(), 3), pid=os.getpid())
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def save_dir():
    """[session_logging] save_dir of $VIBE_HOME/config.toml, else the default."""
    path = os.path.join(VIBE_HOME, "config.toml")
    if os.path.exists(path):
        table = None
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    table = line.strip("[] ")
                    continue
                m = re.match(r'save_dir\s*=\s*"((?:[^"\\]|\\.)*)"', line)
                if table == "session_logging" and m:
                    return m.group(1).replace('\\"', '"').replace("\\\\", "\\")
    return os.path.join(VIBE_HOME, "logs", "session")


def new_session_id():
    head = secrets.token_hex(10)
    return "%s-%s-%s-%s-%s" % (head[:8], head[8:12], head[12:16], head[16:20], secrets.token_hex(6))


def find_session(session_id):
    root = save_dir()
    if not os.path.isdir(root):
        return None
    for name in sorted(os.listdir(root)):
        meta = os.path.join(root, name, "meta.json")
        if name.startswith("session_") and os.path.exists(meta):
            try:
                with open(meta, encoding="utf-8") as f:
                    if json.load(f).get("session_id") == session_id:
                        return os.path.join(root, name)
            except (OSError, ValueError):
                continue
    return None


class Session:
    def __init__(self, session_id, folder, meta):
        self.id, self.folder, self.meta = session_id, folder, meta
        self.cost = 0.0
        self.steps = 0
        self.max_turns = None
        self.max_tokens = None

    @classmethod
    def create(cls, cwd):
        sid = new_session_id()
        folder = os.path.join(save_dir(), "session_%s_%s" % (
            datetime.now().strftime("%Y%m%d_%H%M%S"), sid[:8]))
        os.makedirs(folder)
        meta = {"session_id": sid, "parent_session_id": None, "start_time": now_iso(),
                "end_time": None, "environment": {"working_directory": cwd},
                "username": "<fake>", "title": None, "title_source": "auto",
                "stats": {}, "total_messages": 0}
        s = cls(sid, folder, meta)
        s.write_meta()
        open(os.path.join(folder, "messages.jsonl"), "a").close()
        return s

    @classmethod
    def load(cls, session_id):
        folder = find_session(session_id)
        if folder is None:
            return None
        with open(os.path.join(folder, "meta.json"), encoding="utf-8") as f:
            meta = json.load(f)
        return cls(session_id, folder, meta)

    def write_meta(self):
        self.meta["stats"] = dict(self.meta.get("stats") or {}, steps=self.steps,
                                  session_cost=round(self.cost, 6))
        tmp = os.path.join(self.folder, "meta.json.tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.meta, f, indent=2)
        os.replace(tmp, os.path.join(self.folder, "meta.json"))

    def append(self, role, content):
        with open(os.path.join(self.folder, "messages.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"role": role, "content": content,
                                "message_id": str(uuid.uuid4())}) + "\n")
        self.meta["total_messages"] = self.meta.get("total_messages", 0) + 1
        self.meta["end_time"] = now_iso()
        if role == "user" and not self.meta.get("title"):
            self.meta["title"] = content[:50] + ("…" if len(content) > 50 else "")
            self.meta["title_source"] = "auto"
        self.write_meta()


SESSIONS = {}
NEXT_ID = [1000]


def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def reply(rid, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": rid}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    send(msg)


def update(sid, body):
    send({"jsonrpc": "2.0", "method": "session/update",
          "params": {"sessionId": sid, "update": body}})


def read_message():
    line = sys.stdin.readline()
    if not line:
        return None
    try:
        return json.loads(line)
    except ValueError:
        log({"event": "bad-json", "line": line[:200]})
        return {}


def ask_permission(sid):
    """One session/request_permission, as the real one sends it (toolCallId only).
    Messages that arrive before the answer are kept for the main loop."""
    call_id = "fake" + secrets.token_hex(4)
    update(sid, {"toolCallId": call_id, "title": "bash", "kind": "execute", "status": "pending",
                 "_meta": {"tool_name": "bash"}, "sessionUpdate": "tool_call"})
    rid = NEXT_ID[0]
    NEXT_ID[0] += 1
    send({"jsonrpc": "2.0", "id": rid, "method": "session/request_permission", "params": {
        "sessionId": sid, "toolCall": {"toolCallId": call_id},
        "options": [{"optionId": "allow_once", "name": "Allow once", "kind": "allow_once"},
                    {"optionId": "allow_always", "name": "Allow always", "kind": "allow_always"},
                    {"optionId": "allow_always_permanent", "name": "Allow always (permanent)",
                     "kind": "allow_always"},
                    {"optionId": "reject_once", "name": "Reject once", "kind": "reject_once"}]}})
    held = []
    while True:
        msg = read_message()
        if msg is None:
            return None, held
        if msg.get("id") == rid and "method" not in msg:
            outcome = (msg.get("result") or {}).get("outcome") or {}
            chosen = outcome.get("optionId") if outcome.get("outcome") == "selected" else outcome.get("outcome")
            log({"event": "permission-answer", "session": sid, "option": chosen})
            update(sid, {"toolCallId": call_id, "kind": "execute",
                         "status": "completed" if str(chosen).startswith("allow") else "failed",
                         "sessionUpdate": "tool_call_update"})
            return chosen, held
        held.append(msg)


def answer_sender(session, text):
    sender = re.search(r'<bridge-message [^>]*from="([^"]+)"', text)
    bridge = os.environ.get("BRIDGE")
    if not sender or not bridge:
        return None
    me = "vibe:" + session.id.rsplit("-", 1)[-1]
    r = subprocess.run([sys.executable, bridge, "send", sender.group(1), "pong from " + me,
                        "--from", me], capture_output=True, text=True)
    log({"event": "bridge-reply", "to": sender.group(1), "from": me, "exit": r.returncode,
         "stderr": r.stderr[-300:]})
    return sender.group(1)


def handle_prompt(rid, params, pending):
    sid = params.get("sessionId")
    session = SESSIONS.get(sid)
    if session is None:
        reply(rid, error={"code": INVALID_PARAMS, "message": "Session not found: %s" % sid,
                          "data": {"session_id": sid}})
        return
    text = "".join(b.get("text", "") for b in params.get("prompt") or [] if b.get("type") == "text")
    log({"event": "prompt", "session": sid, "messages": len(re.findall(r"<bridge-message ", text)),
         "max_turns": session.max_turns, "chars": len(text)})
    update(sid, {"content": {"text": text, "type": "text"}, "messageId": str(uuid.uuid4()),
                 "sessionUpdate": "user_message_chunk"})
    if "die-in-prompt" in MODES:
        log({"event": "exit", "code": 3, "why": "die-in-prompt"})
        os._exit(3)
    slow = mode_value("slow")
    if slow:
        time.sleep(float(slow))
    if "error-prompt" in MODES:
        reply(rid, error={"code": INTERNAL_ERROR, "message": "Internal error",
                          "data": {"acp_method": "session/prompt"}})
        return
    session.append("user", text)
    if "die-after-save" in MODES:
        log({"event": "exit", "code": 3, "why": "die-after-save"})
        os._exit(3)
    if "permission" in MODES:
        chosen, held = ask_permission(sid)
        pending.extend(held)
        if chosen is None:
            return
    session.steps += 1
    session.cost += COST
    if "turn-limit" in MODES:
        out = "Turn limit of %s reached" % (session.max_turns or 0)
    else:
        to = answer_sender(session, text)
        out = "pong sent to %s" % to if to else "ok"
    update(sid, {"content": {"text": out, "type": "text"}, "messageId": str(uuid.uuid4()),
                 "sessionUpdate": "agent_message_chunk"})
    session.append("assistant", out)
    update(sid, {"used": 100 * session.steps, "size": 200000,
                 "cost": {"amount": round(session.cost, 6), "currency": "USD"},
                 "sessionUpdate": "usage_update"})
    reply(rid, {"stopReason": "end_turn",
                "usage": {"totalTokens": 100, "inputTokens": 90, "outputTokens": 10}})


CONFIG_OPTIONS = {"configOptions": [{"id": "mode", "currentValue": "default", "options": []}]}


def handle(msg, pending):
    method, rid, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    log({"event": "recv", "method": method, "id": rid, "params": params})
    if method is None:
        return
    if method == "initialize":
        reply(rid, {"protocolVersion": 1, "agentCapabilities": {
            "loadSession": True,
            "promptCapabilities": {"image": True, "audio": False, "embeddedContext": True},
            "sessionCapabilities": {"list": {}, "fork": {}, "close": {}}},
            "authMethods": [], "agentInfo": {"name": "@mistralai/mistral-vibe",
                                             "title": "Mistral Vibe (fake)", "version": "2.20.0"}})
    elif method == "session/new":
        cwd = params.get("cwd") or os.getcwd()
        os.chdir(cwd)
        s = Session.create(cwd)
        SESSIONS[s.id] = s
        reply(rid, {"sessionId": s.id, "modes": {"currentModeId": "default", "availableModes": []}})
    elif method == "session/load":
        sid = params.get("sessionId")
        s = Session.load(sid)
        if s is None:
            reply(rid, error={"code": INVALID_PARAMS, "message": "Session not found: %s" % sid,
                              "data": {"session_id": sid}})
            return
        if params.get("cwd"):
            os.chdir(params["cwd"])
        SESSIONS[sid] = s
        reply(rid, {"modes": {"currentModeId": "default", "availableModes": []}})
    elif method == "session/set_config_option":
        s = SESSIONS.get(params.get("sessionId"))
        if s is None:
            reply(rid, error={"code": INVALID_PARAMS,
                              "message": "Session not found: %s" % params.get("sessionId")})
            return
        if params.get("configId") == "max_turns":
            s.max_turns = int(params.get("value"))
        elif params.get("configId") == "max_tokens":
            s.max_tokens = int(params.get("value"))
        reply(rid, CONFIG_OPTIONS)
    elif method == "session/prompt":
        handle_prompt(rid, params, pending)
    elif rid is not None:
        reply(rid, error={"code": METHOD_NOT_FOUND, "message": "Method not found: %s" % method})


def main():
    for a in sys.argv[1:]:
        if a not in ("-v", "--setup"):
            sys.stderr.write("vibe-acp: unknown option %s\n" % a)
            sys.exit(2)
    log({"event": "start", "argv": sys.argv[1:], "cwd": os.getcwd(), "modes": MODES,
         "env": {k: v for k, v in os.environ.items() if k.startswith("AGENT_BRIDGE_")}})
    pending = []
    while True:
        msg = pending.pop(0) if pending else read_message()
        if msg is None:
            break
        handle(msg, pending)
    log({"event": "exit", "code": 0})


if __name__ == "__main__":
    main()
