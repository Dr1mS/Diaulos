#!/usr/bin/env python3
"""Stand-in for the agy CLI in print mode (agy -p), for the tests.

Writes one JSON line per run to $FAKE_AGY_LOG (cwd, conversation, whether it
resumed one, how many bridge messages the prompt holds), answers the sender
of the first bridge message with "pong from <id prefix>" through bridge.py,
as a real agent would, and prints the JSON line that agy -p --output-format
json prints.
"""
import json
import os
import re
import subprocess
import sys
import uuid

args = sys.argv[1:]
prompt = args[args.index("-p") + 1]
resumed = "--conversation" in args
conversation = args[args.index("--conversation") + 1] if resumed else str(uuid.uuid4())
with open(os.environ["FAKE_AGY_LOG"], "a", encoding="utf-8") as f:
    f.write(json.dumps({"cwd": os.getcwd(), "conversation": conversation, "resume": resumed,
                        "messages": len(re.findall(r"<bridge-message ", prompt))}) + "\n")
sender = re.search(r'from="([^"]+)"', prompt)
if sender:
    subprocess.run([sys.executable, os.environ["BRIDGE"], "send", sender.group(1),
                    f"pong from {conversation[:8]}", "--from", f"agy:{conversation}"], capture_output=True)
print(json.dumps({"conversation_id": conversation, "status": "SUCCESS", "response": "ok", "num_turns": 1}))
